# ─── Bot ───────────────────────────────────────────────────────────
# Token from @BotFather
BOT_TOKEN=123456789:AAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# development | production
NODE_ENV=development

# Comma separated Telegram user IDs of admins
ADMIN_IDS=123456789,987654321

# ─── MongoDB ───────────────────────────────────────────────────────
# Local: mongodb://127.0.0.1:27017/adbot
# Cloud: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/adbot
MONGO_URI=mongodb://127.0.0.1:27017/adbot

# ─── Channel ────────────────────────────────────────────────────────
# Telegram channel username (without @) for membership check
CHANNEL_USERNAME=bfsstamil

# Invite link used in redirect/join buttons (no username needed)
CHANNEL_INVITE=https://t.me/+7RP9Zro49OA4M2Rl

# ─── Webhook (production only) ─────────────────────────────────────
# Optional — in production the bot auto-detects RAILWAY_PUBLIC_DOMAIN.
# Set explicitly if the domain is not auto-detected:
# WEBHOOK_URL=https://your-app.up.railway.app
# WEBHOOK_SECRET=random-secret-string
# WEBHOOK_PATH=/webhook

# Railway sets PORT automatically (defaults to 3000)
# PORT=3000