# ─── Bot ───────────────────────────────────────────────────────────
# Token from @BotFather
BOT_TOKEN=123456789:AAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# development | production
NODE_ENV=development

# Comma separated Telegram user IDs of admins
ADMIN_IDS=123456789,987654321

# ─── MongoDB ───────────────────────────────────────────────────────
# Local: mongodb://127.0.0.1:27017/adbot
# Cloud: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/adbot
MONGO_URI=mongodb://127.0.0.1:27017/adbot

# ─── Channel ────────────────────────────────────────────────────────
# Recommended: numeric target channel ID, especially for private channels.
# The bot must be an administrator to receive chat_member updates.
# When set, CHANNEL_ID takes precedence over CHANNEL_USERNAME for verification.
CHANNEL_ID=

# Telegram channel username (without @) for membership check
CHANNEL_USERNAME=your-channel-username

# Invite link used in redirect/join buttons (no username needed)
CHANNEL_INVITE=https://t.me/+your-channel-invite

# Channel that receives "user joined" logs (bot must be an admin there)
# JOIN_LOG_CHANNEL_ID=-1003902452318

# ─── Webhook (production only) ─────────────────────────────────────
# Optional — in production the bot auto-detects RAILWAY_PUBLIC_DOMAIN.
# Set explicitly if the domain is not auto-detected:
# WEBHOOK_URL=https://your-app.up.railway.app
# WEBHOOK_SECRET=random-secret-string
# WEBHOOK_PATH=/webhook

# Railway sets PORT automatically (defaults to 3000)
# PORT=3000

# Membership check pacing (non-channel broadcast and conversion verification)
# Telegram heavily rate-limits getChatMember, so the bot paces itself and backs
# off automatically. Higher intervals are slower.
# CHANNEL_CHECK_INTERVAL_MS=400

# Max duration of a non-channel broadcast scan in ms. 0 = no time limit.
# CHANNEL_SCAN_MAX_MS=0

# ─── Landing attribution + Meta Conversions API ────────────────────
# Match BOT_ATTRIBUTION_SECRET on the landing server. Enables POST /api/attribution.
# Set the same long random secret in both projects; leave blank to disable handoff.
# In landing: BOT_ATTRIBUTION_URL=https://your-bot-host/api/attribution
BOT_ATTRIBUTION_SECRET=

# Prefer /admin → Meta Tracking to save Pixel ID and CAPI token in MongoDB.
# No META_PIXEL_ID or META_ACCESS_TOKEN env values are needed with admin setup.
# These environment variables are optional fallbacks; admin settings override them.
# Same Pixel/dataset ID as NEXT_PUBLIC_META_PIXEL_ID on the landing page.
# META_PIXEL_ID=123456789012345
# Server-only Conversions API access token from Meta Events Manager.
# META_ACCESS_TOKEN=replace-with-your-conversions-api-token
# META_API_VERSION=v25.0
# Optional: use Meta Test Events during setup; remove for live delivery.
# META_TEST_EVENT_CODE=TEST12345
